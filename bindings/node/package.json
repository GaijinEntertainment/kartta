{
	"name": "@gaijin/kartta",
	"version": "0.1.0",
	"description": "Node.js binding of the kartta code graph engine: file search, content search and graph queries",
	"keywords": [
		"call-graph",
		"code-graph",
		"napi",
		"search",
		"static-analysis"
	],
	"license": "MIT",
	"author": "Gaijin Entertainment",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/GaijinEntertainment/kartta.git",
		"directory": "bindings/node"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/kartta.d.ts",
			"default": "./dist/kartta.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "node scripts/build.ts",
		"typecheck": "tsc",
		"test": "vp test",
		"prepack": "tsc -p tsconfig.build.json && node scripts/stage.ts"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"@ver0/oxlint-config": "2.0.4",
		"typescript": "7.0.2",
		"vite-plus": "1.5.0"
	},
	"optionalDependencies": {
		"@gaijin/kartta-darwin-arm64": "0.1.0",
		"@gaijin/kartta-linux-arm64-gnu": "0.1.0",
		"@gaijin/kartta-linux-arm64-musl": "0.1.0",
		"@gaijin/kartta-linux-x64-gnu": "0.1.0",
		"@gaijin/kartta-linux-x64-musl": "0.1.0",
		"@gaijin/kartta-win32-x64-msvc": "0.1.0"
	},
	"engines": {
		"node": ">=24"
	}
}
